<p><%= t(".greeting") %></p>
<p><%= t(".body") %></p>
<p><a href="<%= @url %>" style="display:inline-block;padding:12px 22px;background:#5b5781;color:#fff;border-radius:999px;text-decoration:none;font-weight:600"><%= t(".button") %></a></p>
<% if @code %>
<%# The code as a nursery label (Semisto Nursery): kraft tag, eyelet, pencil
    rule, sown and plant-out times. Tables and inline styles only; the digits
    stay one text run so mail apps can offer to copy or autofill them. %>
<% serif = "'EB Garamond',Georgia,serif" %>
<%# EB Garamond where the mail app loads web fonts (Apple Mail), Georgia elsewhere. %>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&display=swap" rel="stylesheet">
<p style="margin:28px 0 10px;"><%= t(".code_intro") %></p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:400px;border-collapse:separate;background:#f1e4c6;border:1px solid #d8c39a;border-left:8px solid #afbd00;border-radius:6px 22px 22px 6px;">
  <tr>
    <td width="44" valign="middle" align="center" style="padding:0 0 0 10px;">
      <div style="width:16px;height:16px;border-radius:50%;background:#ffffff;border:2px solid #c9b183;line-height:16px;font-size:0;">&nbsp;</div>
    </td>
    <td style="padding:16px 22px 16px 10px;">
      <div style="font:600 11px/1.4 -apple-system,'Segoe UI',Helvetica,Arial,sans-serif;letter-spacing:2px;text-transform:uppercase;color:#7a6a45;"><%= t(".code_label") %></div>
      <div style="font:500 42px/1.15 <%= serif %>;letter-spacing:12px;color:#3c3956;padding:6px 0 6px;border-bottom:1px dashed #b9a272;"><%= @code %></div>
      <div style="font:15px/1.5 <%= serif %>;color:#5f5440;padding-top:8px;"><%= t(".code_times", sown: l(@sown_at, format: :sign_in_time), wilts: l(@wilts_at, format: :sign_in_time)) %></div>
    </td>
  </tr>
</table>
<% end %>
<p style="color:#6b6257;font-size:13px;margin-top:24px;"><%= t(".expiry") %></p>
