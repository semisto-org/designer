<p><%= t(".greeting", name: @user.display_name) %></p>
<p><%= t(".body", kind: kind_label.downcase, map: @map.name) %></p>
<table style="border-collapse:collapse;font-size:14px">
  <% @summary.each do |line| %>
    <tr><td style="padding:4px 12px 4px 0;color:#6b6257;vertical-align:top"><%= line[:label] %></td><td style="white-space:pre-line"><%= line[:value] %></td></tr>
  <% end %>
</table>
<p><%= t(".next") %></p>
<p style="color:#6b6257;font-size:13px"><%= t(".privacy") %></p>
<p><a href="<%= @map_url %>" style="display:inline-block;padding:12px 20px;background:#3b5d3a;color:#fff;border-radius:8px;text-decoration:none"><%= t(".open_map") %></a></p>
