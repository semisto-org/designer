<%= t("billing_mailer.greeting", name: @user.display_name) %>

<%= t("#{@copy}.#{@kind}.body", plan: @plan, date: @ends_on) %>

<% if @kind == "expired" -%>
<%= @read_only_maps.positive? ? t("#{@copy}.expired.read_only", count: @read_only_maps) : t("invoicing_mailer.grant_reminder.expired.free_ok") %>
<% else -%>
<%= t("#{@copy}.renew") %>
<% end -%>

<%= t("#{@copy}.cta") %> : <%= @renew_url %>

<%= t("invoicing_mailer.grant_reminder.no_auto") %> <%= t("billing_mailer.renewal_reminder.readable") %>

<%= render "mail_places", places: (@place_names unless @kind == "expired") %><%= render "mail_supports" %><%= t("billing_mailer.signature") %>
<%= t("billing_mailer.team") %>
