<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
  </head>
  <%# A page of the field notebook. Inline styles and tables only: e-mail clients ignore style sheets. Colours: Semisto loam, prune and leaf tokens. %>
  <% font = "Inter,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif" %>
  <% serif = "'EB Garamond',Garamond,Georgia,'Times New Roman',serif" %>
  <body style="margin:0;padding:0;background:#f7f3ea;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f7f3ea;">
      <tr>
        <td align="center" style="padding:28px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
            <tr>
              <td style="padding:0 6px 16px;">
                <span style="font:600 22px/1.2 <%= serif %>;color:#5b5781;">Semisto</span>
                <span style="font:400 22px/1.2 <%= serif %>;color:#4d5500;">Terranova</span>
              </td>
            </tr>
            <tr>
              <td style="background:#fffdf8;border:1px solid #e3dac8;border-radius:16px;padding:0;">
                <% if @place %>
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td style="padding:16px 16px 0;">
                        <a href="<%= @place[:url] %>" style="text-decoration:none;color:#36342f;">
                          <% if @place[:image] && attachments[@place[:image]] %>
                            <img src="<%= attachments[@place[:image]].url %>" width="526" alt="<%= t("mailer.place_alt", name: @place[:name]) %>" style="display:block;width:100%;max-width:526px;height:auto;border:0;border-radius:12px;background:#f7f3ea;">
                          <% end %>
                          <span style="display:block;padding:10px 4px 0;font:600 18px/1.3 <%= serif %>;color:#36342f;">« <%= @place[:name] %> »</span>
                          <% caption = mail_place_caption(@place) %>
                          <% if caption.present? %><span style="display:block;padding:2px 4px 0;font:14px/1.4 <%= font %>;color:#595650;"><%= caption %></span><% end %>
                        </a>
                      </td>
                    </tr>
                    <tr><td style="padding:16px 20px 0;"><div style="border-top:1px dashed #d8cfbd;font-size:0;line-height:0;">&nbsp;</div></td></tr>
                  </table>
                <% end %>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="padding:24px;font:15px/1.6 <%= font %>;color:#1b1712;">
                      <%= yield %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 6px 0;font:14px/1.5 <%= font %>;color:#595650;">
                <%= t("mailer.footer") %>
                <a href="<%= root_url %>" style="color:#5b5781;"><%= root_url.sub(%r{\Ahttps?://}, "").delete_suffix("/") %></a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
