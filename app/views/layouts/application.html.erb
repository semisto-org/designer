<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Semisto Designer">
    <meta name="mobile-web-app-capable" content="yes">
    <%# Pages that set Inertia meta tags (public site, help) render title, description, canonical and Open Graph here; others get the defaults. %>
    <% page_meta_tags = inertia_meta_tags %>
    <% if page_meta_tags.present? %>
      <%= page_meta_tags %>
    <% else %>
      <title data-inertia><%= content_for(:title) || "Semisto Designer" %></title>
      <meta name="description" content="<%= t("meta.description") %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= sentry_meta_tags %>
    <%= yield :head %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#ffffff">
    
    <%= vite_stylesheet_tag "application.css" %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "inertia.tsx" %>
    <%= inertia_ssr_head %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
