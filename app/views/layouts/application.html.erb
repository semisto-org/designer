<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Semisto Designer">
    <meta name="mobile-web-app-capable" content="yes">
    <%# Pages that set Inertia meta tags (public site, help) render title, description, canonical and Open Graph here; others get the defaults. %>
    <% page_meta_tags = inertia_meta_tags %>
    <% if page_meta_tags.present? %>
      <%= page_meta_tags %>
    <% else %>
      <title data-inertia><%= content_for(:title) || "Semisto Designer" %></title>
      <meta name="description" content="<%= t("meta.description") %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= sentry_meta_tags %>
    <%= yield :head %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#ffffff">
    
    <%# After a deploy, a page may still point at chunks of the previous build: reload once to get the new one. %>
    <%= javascript_tag <<~JS
      (function () {
        var KEY = "designer:stale-build-reload"
        function reload() {
          try {
            var last = Number(sessionStorage.getItem(KEY) || 0)
            if (Date.now() - last < 30000) return false
            sessionStorage.setItem(KEY, String(Date.now()))
          } catch (e) { return false }
          location.reload()
          return true
        }
        window.addEventListener("error", function (event) {
          var el = event.target
          var url = el && (el.src || el.href)
          if (url && (el.tagName === "SCRIPT" || el.tagName === "LINK") && url.indexOf("/vite/") !== -1) reload()
        }, true)
        window.addEventListener("vite:preloadError", function (event) {
          if (reload()) event.preventDefault()
        })
      })()
    JS
    %>
    <%= vite_stylesheet_tag "application.css" %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "inertia.tsx" %>
    <%= inertia_ssr_head %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
