<p><%= t(".greeting") %></p>
<% if @viewer %>
<p><%= t(".body_viewer", inviter: @inviter.display_name, map: @map.name) %></p>
<% else %>
<p><%= t(".body", inviter: @inviter.display_name, map: @map.name, role: t("maps.roles.#{@invitation.role}").downcase) %></p>
<% end %>
<p style="color:#6b6257"><%= t(".role_#{@invitation.role}") %><% if @viewer && @invitation.chat_access %> <%= t(".chat") %><% end %></p>
<p style="color:#4f6b2a"><%= t(".since", date: l(@map.created_at.to_date, format: "%B %Y")) %></p>
<p><a href="<%= @url %>" style="display:inline-block;padding:12px 20px;background:#5b5781;color:#fff;border-radius:999px;text-decoration:none;font-weight:600"><%= t(@viewer ? ".button_viewer" : ".button") %></a></p>
<% if @guide %>
<p style="color:#6b6257"><%= t(".guide_viewer", title: @guide.title) %> <a href="<%= @guide_url %>" style="color:#5b5781"><%= @guide_url %></a></p>
<% end %>
<p style="color:#6b6257;font-size:13px"><%= t(".signin_hint") %></p>
<p style="color:#6b6257;font-size:13px"><%= t(".expiry", date: @invitation.expires_at.strftime("%d/%m/%Y")) %></p>
