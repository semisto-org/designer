{
  "expo": {
    "name": "Semisto Terranova",
    "slug": "semisto-designer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "org.semisto.designer",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.semisto.designer",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.semisto.designer",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Semisto Terranova montre où tu es sur le plan de ton terrain et place tes photos, relevés et plantations.",
          "locationAlwaysAndWhenInUsePermission": "Semisto Terranova continue d'enregistrer ta trace quand l'écran est éteint, pendant que tu marches le long d'une haie ou d'une limite.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Semisto Terranova photographie et filme ton terrain et tes plantes pour les rattacher à la carte.",
          "photosPermission": "Semisto Terranova importe des photos et des vidéos de ton terrain déjà prises.",
          "microphonePermission": "Semisto Terranova enregistre le son des vidéos que tu filmes sur ton terrain."
        }
      ],
      "expo-font",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://terranova.semisto.org",
      "eas": {
        "projectId": "cf4ef807-5bd3-4f05-9170-9a8b855fef40"
      }
    },
    "owner": "semisto.org",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cf4ef807-5bd3-4f05-9170-9a8b855fef40"
    }
  }
}
