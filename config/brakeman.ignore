      "code": "ActiveRecord::Base.connection.select_value(\"WITH input AS (\\n  SELECT ST_MakeValid(ST_SnapToGrid(ST_MakeValid(g), 0.0000001)) AS g\\n  FROM unnest(ARRAY[#{geometries.map do\n \"ST_Transform(ST_SetSRID(ST_GeomFromGeoJSON(#{ActiveRecord::Base.connection.quote(geometry.to_json)}), #{Integer(srid)}), 4326)\"\n end.join(\", \")}]) AS g\\n), merged AS (\\n  SELECT ST_CollectionExtract(ST_MakeValid(ST_UnaryUnion(ST_Collect(g))), 3) AS g FROM input\\n), closed AS (\\n  SELECT ST_CollectionExtract(ST_MakeValid(\\n    ST_Buffer(ST_Buffer(g, #{7.0e-07}, 'join=mitre mitre_limit=5'), -#{7.0e-07}, 'join=mitre mitre_limit=5')\\n  ), 3) AS g FROM merged\\n)\\nSELECT ST_AsGeoJSON(ST_Multi(CASE WHEN ST_IsEmpty(closed.g) THEN merged.g ELSE closed.g END), 8)\\nFROM closed, merged\\n\".squish, \"Boundaries::GeometryUnion\")",
      "render_path": null,
      "location": {
        "type": "method",
        "class": "Boundaries::GeometryUnion",
        "method": "call"
      },
      "user_input": "geometries.map do\n \"ST_Transform(ST_SetSRID(ST_GeomFromGeoJSON(#{ActiveRecord::Base.connection.quote(geometry.to_json)}), #{Integer(srid)}), 4326)\"\n end.join(\", \")",
      "confidence": "Medium",
